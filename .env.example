# Copia a .env.local y rellena con el proyecto Firebase (acceso + notas).
# Sin estas variables la app no deja entrar.
#
# Correos autorizados, separados por coma. También se puede dar de alta
# el mismo correo en Firestore: colección allowlist, documento = email,
# campo enabled = true.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_ALLOWED_EMAILS=
