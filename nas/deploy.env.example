# Copia a nas/deploy.env (gitignored) y ajusta si montas otra ruta SMB.
# Por defecto: home SMB de Pablo en el DS220+ (192.168.1.131).

NAS_HOST=192.168.1.131
NAS_PUBLISH_DIR=/Volumes/homes/Pablo/www/scada
# Opcional: segunda copia (antes Pages “móvil”)
NAS_PUBLISH_DIR_MOBILE=/Volumes/homes/Pablo/www/scada-movil
# Si es 1, también copia a scada-movil
NAS_MIRROR_MOBILE=1
